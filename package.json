{
  "name": "@hoshinotatsuya/contracts",
  "version": "0.4.0",
  "description": "Executable contracts between independently deployed repositories: deterministic schema snapshots from Zod or TypeScript, directional writer-to-reader compatibility checked against the other side's deployed revision, versioned payloads with tolerant reads, a Jest gate and a CLI.",
  "keywords": [
    "contract",
    "contract-testing",
    "schema",
    "zod",
    "typescript",
    "compatibility",
    "snapshot",
    "message-queue",
    "redis",
    "ci",
    "jest",
    "cli"
  ],
  "license": "MIT",
  "author": "Hoshino_Tatsuya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoshinoTatsuya/contracts.git"
  },
  "homepage": "https://github.com/HoshinoTatsuya/contracts#readme",
  "bugs": {
    "url": "https://github.com/HoshinoTatsuya/contracts/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "contracts": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./typescript": {
      "types": "./dist/typescript/index.d.ts",
      "default": "./dist/typescript/index.js"
    },
    "./jest": {
      "types": "./dist/jest/index.d.ts",
      "default": "./dist/jest/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "typescript": [
        "./dist/typescript/index.d.ts"
      ],
      "jest": [
        "./dist/jest/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "lint": "biome check src examples",
    "test": "pnpm run build && JEST_GROUPS_STRICT=1 jest-groups --out .jest-report.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report.json",
    "test:consumers": "scripts/consumer-matrix.sh",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run test:consumers && pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@jest/globals": ">=29",
    "@typescript/typescript6": "^6.0.2",
    "typescript": ">=5.9.0 <7.2.0 || >=7.1.0-beta <7.2.0",
    "zod": ">=4.0.0 <5"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    },
    "@typescript/typescript6": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@jest/globals": "30.5.2",
    "@hoshinotatsuya/arch-gates": "^0.12.2",
    "@hoshinotatsuya/jest-groups": "^0.7.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.15",
    "@typescript/typescript6": "6.0.2",
    "jest": "30.5.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "typescript-6": "npm:typescript@6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-7-1": "npm:typescript@7.1.0-beta",
    "zod": "4.6.5"
  }
}
